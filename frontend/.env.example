# Enoki zkLogin — Google sign-in as a wallet option in ConnectButton.
# Get these from https://portal.enoki.mystenlabs.com (API key) and the
# Google Cloud Console (OAuth 2.0 Web Client ID). Must be NEXT_PUBLIC_
# since lib/dapp-kit.ts only ever runs client-side.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
